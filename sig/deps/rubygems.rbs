module Gem
  class Version
    def to_s: -> String
  end

  class Specification
    def self.find_by_name: (String name) -> Specification
    def self.to_a: -> Array[Specification]

    attr_reader name: String
    attr_reader version: Version
    attr_reader summary: String?
    attr_reader require_paths: Array[String]
    attr_reader full_gem_path: String
    attr_reader doc_dir: String
  end
end
