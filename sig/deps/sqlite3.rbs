module SQLite3
  class Database
    def initialize: (String path) -> void
    def execute_batch: (String sql) -> untyped
    def execute: (String sql, *untyped bind_vars) -> Array[Array[untyped]]
    def get_first_row: (String sql, *untyped bind_vars) -> Array[untyped]?
    def close: -> void
  end
end
